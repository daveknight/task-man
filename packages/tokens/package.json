  "scripts": {
    "generate": "tsx src/generate/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
