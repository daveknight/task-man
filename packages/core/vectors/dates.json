{
  "function": "resolveDate(input, today), weekdayOf(date), nextWeekdayOnOrAfter(date, weekdays)",
  "description": "Relative dates used by the CLI and seed files. Months and years clamp at month ends. expectError means the input must be rejected.",
  "resolveDate": [
    { "today": "2026-11-18", "input": "today", "expect": "2026-11-18" },
    { "today": "2026-11-18", "input": "TODAY", "expect": "2026-11-18" },
    { "today": "2026-11-18", "input": "+0d", "expect": "2026-11-18" },
    { "today": "2026-11-18", "input": "+1d", "expect": "2026-11-19" },
    { "today": "2026-11-18", "input": "+3D", "expect": "2026-11-21" },
    { "today": "2026-11-18", "input": "-2d", "expect": "2026-11-16" },
    { "today": "2026-11-18", "input": "-40d", "expect": "2026-10-09" },
    { "today": "2026-11-18", "input": "+60d", "expect": "2027-01-17" },
    { "today": "2026-11-18", "input": "+2w", "expect": "2026-12-02" },
    { "today": "2026-11-18", "input": "-1w", "expect": "2026-11-11" },
    { "today": "2026-11-18", "input": "+1m", "expect": "2026-12-18" },
    { "today": "2026-11-18", "input": "+2m", "expect": "2027-01-18" },
    { "today": "2026-11-18", "input": "+1y", "expect": "2027-11-18" },
    { "today": "2026-12-31", "input": "+1d", "expect": "2027-01-01" },
    { "today": "2026-01-01", "input": "-1d", "expect": "2025-12-31" },
    { "today": "2026-01-31", "input": "+1m", "expect": "2026-02-28" },
    { "today": "2028-01-31", "input": "+1m", "expect": "2028-02-29" },
    { "today": "2026-03-31", "input": "-1m", "expect": "2026-02-28" },
    { "today": "2026-10-31", "input": "+1m", "expect": "2026-11-30" },
    { "today": "2026-08-31", "input": "+6m", "expect": "2027-02-28" },
    { "today": "2028-02-29", "input": "+1y", "expect": "2029-02-28" },
    { "today": "2028-02-29", "input": "+4y", "expect": "2032-02-29" },
    { "today": "2026-11-18", "input": "2026-12-01", "expect": "2026-12-01" },
    { "today": "2026-11-18", "input": " +1d ", "expect": "2026-11-19" },
    { "today": "2026-11-18", "input": "2026-02-30", "expectError": true },
    { "today": "2026-11-18", "input": "2026-13-01", "expectError": true },
    { "today": "2026-11-18", "input": "tomorrow", "expectError": true },
    { "today": "2026-11-18", "input": "+3x", "expectError": true },
    { "today": "2026-11-18", "input": "3d", "expectError": true },
    { "today": "2026-11-18", "input": "", "expectError": true }
  ],
  "weekdayOf": [
    { "date": "2026-11-18", "expect": "wed" },
    { "date": "2026-11-21", "expect": "sat" },
    { "date": "2026-11-22", "expect": "sun" },
    { "date": "2026-11-23", "expect": "mon" },
    { "date": "2028-02-29", "expect": "tue" },
    { "date": "2027-01-01", "expect": "fri" }
  ],
  "nextWeekdayOnOrAfter": [
    { "date": "2026-11-18", "weekdays": ["mon", "tue", "wed", "thu", "fri"], "expect": "2026-11-18" },
    { "date": "2026-11-21", "weekdays": ["mon", "tue", "wed", "thu", "fri"], "expect": "2026-11-23" },
    { "date": "2026-11-22", "weekdays": ["mon", "tue", "wed", "thu", "fri"], "expect": "2026-11-23" },
    { "date": "2026-11-18", "weekdays": ["sun"], "expect": "2026-11-22" },
    { "date": "2026-12-30", "weekdays": ["mon"], "expect": "2027-01-04" },
    { "date": "2026-11-18", "weekdays": [], "expect": "2026-11-18" }
  ]
}
