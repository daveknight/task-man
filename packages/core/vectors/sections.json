{
  "function": "sectionFor(task, today) and waitingStateFor(task, today)",
  "description": "Which board section a task is in. Omitted task fields are null, status defaults to 'open'. expect.waitingState is present only for tasks in the waiting section.",
  "cases": [
    { "name": "open, no dates", "today": "2026-11-18", "task": {}, "expect": { "section": "ready" } },
    { "name": "open, start today (boundary)", "today": "2026-11-18", "task": { "startDate": "2026-11-18" }, "expect": { "section": "ready" } },
    { "name": "open, start yesterday", "today": "2026-11-18", "task": { "startDate": "2026-11-17" }, "expect": { "section": "ready" } },
    { "name": "open, start tomorrow", "today": "2026-11-18", "task": { "startDate": "2026-11-19" }, "expect": { "section": "upcoming" } },
    { "name": "open, overdue due date stays ready", "today": "2026-11-18", "task": { "dueDate": "2026-11-15" }, "expect": { "section": "ready" } },
    { "name": "open, future due date, no start", "today": "2026-11-18", "task": { "dueDate": "2026-12-25" }, "expect": { "section": "ready" } },
    { "name": "open, future start and due", "today": "2026-11-18", "task": { "startDate": "2027-01-17", "dueDate": "2027-04-17" }, "expect": { "section": "upcoming" } },
    { "name": "in progress", "today": "2026-11-18", "task": { "status": "in_progress" }, "expect": { "section": "in_progress" } },
    { "name": "in progress, start in the past", "today": "2026-11-18", "task": { "status": "in_progress", "startDate": "2026-11-01" }, "expect": { "section": "in_progress" } },
    { "name": "future start wins over in progress", "today": "2026-11-18", "task": { "status": "in_progress", "startDate": "2026-11-19" }, "expect": { "section": "upcoming" } },
    { "name": "future start wins over waiting", "today": "2026-11-18", "task": { "status": "waiting", "startDate": "2026-11-25" }, "expect": { "section": "upcoming" } },
    { "name": "waiting, no check-back date", "today": "2026-11-18", "task": { "status": "waiting" }, "expect": { "section": "waiting", "waitingState": "needs_follow_up" } },
    { "name": "waiting, check-back today", "today": "2026-11-18", "task": { "status": "waiting", "waitUntil": "2026-11-18" }, "expect": { "section": "waiting", "waitingState": "needs_follow_up" } },
    { "name": "waiting, check-back yesterday", "today": "2026-11-18", "task": { "status": "waiting", "waitUntil": "2026-11-17" }, "expect": { "section": "waiting", "waitingState": "needs_follow_up" } },
    { "name": "waiting, check-back tomorrow", "today": "2026-11-18", "task": { "status": "waiting", "waitUntil": "2026-11-19" }, "expect": { "section": "waiting", "waitingState": "later" } },
    { "name": "waiting until later, but due today", "today": "2026-11-18", "task": { "status": "waiting", "waitUntil": "2026-11-25", "dueDate": "2026-11-18" }, "expect": { "section": "waiting", "waitingState": "needs_follow_up" } },
    { "name": "waiting until later, but overdue", "today": "2026-11-18", "task": { "status": "waiting", "waitUntil": "2026-11-25", "dueDate": "2026-11-10" }, "expect": { "section": "waiting", "waitingState": "needs_follow_up" } },
    { "name": "waiting until later, due tomorrow", "today": "2026-11-18", "task": { "status": "waiting", "waitUntil": "2026-11-25", "dueDate": "2026-11-19" }, "expect": { "section": "waiting", "waitingState": "later" } },
    { "name": "waiting, start today", "today": "2026-11-18", "task": { "status": "waiting", "startDate": "2026-11-18", "waitUntil": "2026-11-20" }, "expect": { "section": "waiting", "waitingState": "later" } },
    { "name": "stale waiting fields on an open task are ignored", "today": "2026-11-18", "task": { "status": "open", "waitUntil": "2026-11-25" }, "expect": { "section": "ready" } },
    { "name": "completed", "today": "2026-11-18", "task": { "completedAt": "2026-11-17T12:00:00Z", "completedOn": "2026-11-17" }, "expect": { "section": "completed" } },
    { "name": "completed keeps its status but shows as completed", "today": "2026-11-18", "task": { "status": "waiting", "completedAt": "2026-11-17T12:00:00Z", "completedOn": "2026-11-17" }, "expect": { "section": "completed" } },
    { "name": "completed wins over a future start", "today": "2026-11-18", "task": { "startDate": "2026-12-01", "completedAt": "2026-11-17T12:00:00Z", "completedOn": "2026-11-17" }, "expect": { "section": "completed" } },
    { "name": "deleted", "today": "2026-11-18", "task": { "deletedAt": "2026-11-17T12:00:00Z", "deletedOn": "2026-11-17" }, "expect": { "section": "trash" } },
    { "name": "deleted wins over completed", "today": "2026-11-18", "task": { "completedAt": "2026-11-10T12:00:00Z", "completedOn": "2026-11-10", "deletedAt": "2026-11-17T12:00:00Z", "deletedOn": "2026-11-17" }, "expect": { "section": "trash" } },
    { "name": "deleted wins over waiting", "today": "2026-11-18", "task": { "status": "waiting", "deletedAt": "2026-11-17T12:00:00Z", "deletedOn": "2026-11-17" }, "expect": { "section": "trash" } },
    { "name": "month boundary: start Dec 1 on Nov 30", "today": "2026-11-30", "task": { "startDate": "2026-12-01" }, "expect": { "section": "upcoming" } },
    { "name": "month boundary: start Dec 1 on Dec 1", "today": "2026-12-01", "task": { "startDate": "2026-12-01" }, "expect": { "section": "ready" } },
    { "name": "year boundary: start Jan 1 on Dec 31", "today": "2026-12-31", "task": { "startDate": "2027-01-01" }, "expect": { "section": "upcoming" } },
    { "name": "year boundary: check-back Jan 1 on Dec 31", "today": "2026-12-31", "task": { "status": "waiting", "waitUntil": "2027-01-01" }, "expect": { "section": "waiting", "waitingState": "later" } },
    { "name": "leap day start on Feb 28", "today": "2028-02-28", "task": { "startDate": "2028-02-29" }, "expect": { "section": "upcoming" } }
  ]
}
