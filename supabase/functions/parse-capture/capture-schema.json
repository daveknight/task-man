{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "confidence", "actions"],
  "properties": {
    "summary": { "type": "string" },
    "confidence": { "type": "string", "enum": ["high", "low"] },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["create", "update", "append_note"] },
          "title": { "type": "string" },
          "match": { "type": "string" },
          "text": { "type": "string" },
          "description": { "type": "string" },
          "startDate": { "type": "string" },
          "hideUntil": { "type": "string" },
          "dueDate": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "in_progress", "waiting"] },
          "flagged": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "subtasks": { "type": "array", "items": { "type": "string" } },
          "repeat": { "type": "object" }
        }
      }
    }
  }
}
